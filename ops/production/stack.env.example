# Generated production secrets belong in stack.env (mode 600), never in Git.
DAOFLOW_STACK_ENV_FILE=/opt/daoflow/shared/stack.env
SUPABASE_VENDOR_DIR=/opt/daoflow/vendor/supabase
DAOFLOW_IMAGE_TAG=
DAOFLOW_APP_PORT=18083
DAOFLOW_API_PORT=18084

NEXT_PUBLIC_SUPABASE_URL=https://dao.shinluv.cloud
SUPABASE_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_SECRET=
POSTGRES_PASSWORD=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

SITE_URL=https://dao.shinluv.cloud
API_EXTERNAL_URL=https://dao.shinluv.cloud/auth/v1
ADDITIONAL_REDIRECT_URLS=https://dao.shinluv.cloud/**,https://tanfeng.shinluv.cloud/**

SMTP_ADMIN_EMAIL=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=DaoFlow
MAILER_EXTERNAL_HOSTS=dao.shinluv.cloud,tanfeng.shinluv.cloud

AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# BFF / worker secrets. Generate independent 32+ character values in the
# deployment secret store; the Caddy process needs the same proxy attestation.
DAOFLOW_PUBLIC_ORIGIN=https://dao.shinluv.cloud
DAOFLOW_AUTH_TRANSACTION_SECRET=
DAOFLOW_RATE_LIMIT_HMAC_KEY=
DAOFLOW_PROXY_ATTESTATION_SECRET=
DAOFLOW_ASK_WORKER_TOKEN=
DAOFLOW_ASK_WORKER_ID=
DAOFLOW_CORPUS_VERSION=dao-de-jing-wang-bi-v1
