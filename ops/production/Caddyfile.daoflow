dao.shinluv.cloud, tanfeng.shinluv.cloud {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    @private path /.env /.git/* /Dockerfile /package.json /package-lock.json /ops/*
    respond @private 404

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=15552000"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    }

    @supabase path /auth/v1/* /rest/v1/*
    handle @supabase {
        reverse_proxy daoflow-api:8000
    }

    handle {
        reverse_proxy daoflow-app:3000 {
            # Each set operation replaces browser-supplied metadata. The app
            # accepts identity only when this Caddy hop supplies its own
            # process-only attestation.
            header_up X-Daoflow-Client-Ip {remote_host}
            header_up X-Daoflow-Proxy-Attestation {$DAOFLOW_PROXY_ATTESTATION_SECRET}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Real-IP {remote_host}
        }
    }
}
